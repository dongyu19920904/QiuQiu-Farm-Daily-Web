{{ $pages := slice }}{{ range site.RegularPages }}{{ if findRE "^[0-9]{4}-[0-9]{2}$" .Section }}{{ $pages = $pages | append . }}{{ end }}{{ end }}<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ site.Title }}</title><link>{{ .Permalink }}</link><description>农业AI、种菜技巧与田园实践，逐条附真实来源。</description><language>zh-CN</language>{{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}{{ range first 50 (sort $pages "Date" "desc") }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Content | html }}</description></item>{{ end }}</channel></rss>
